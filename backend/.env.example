# Copy to backend/.env. Never put credentials in Vue or Git.
PEYCE_MODEL_MODE=mock
PEYCE_DB_PATH=backend/.runtime/peyce.sqlite3
PEYCE_MODEL_TIMEOUT_SECONDS=8
PEYCE_TEST_CONTROLS=0

