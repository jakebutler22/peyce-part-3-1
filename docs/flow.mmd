flowchart TD
  entry["Entry · coursework prototype\nFind an exercise / Choose an exercise"]
  notice["Optional check-in notice\nFace selection advances · correction available"]
  questions["Five fixed questions · one per screen\nSame vector faces + question-specific text"]
  rule["Versioned deterministic rule\nPreferences before cue comparison\nNo score or diagnosis"]
  choices["Equal choices / neither forced\nChoose deliberately or finish"]
  ready["Exercise ready\nShort reason + instructions\nStart / alternative / exit"]
  breathing["Breathing experiment\n4 s in · 6 s out · 6 cycles\nPause / stop / switch"]
  grounding["Grounding\n5 seen → 4 felt → 3 heard → 2 smelled → 1 tasted\nPrivate noticing · Next / Back / skip sense"]
  endstate["Neutral completion / stopped\nFinish / try other · future optional checkout"]
  history["Past sessions\nClearly fictional in-memory examples"]
  support["Support overlay · accessible from EVERY state\nNo person monitoring · verified region-labeled resources\nClose / return to stop or exit"]
  fallback["Explanation unavailable\nCanned approved reason; access remains immediate"]
